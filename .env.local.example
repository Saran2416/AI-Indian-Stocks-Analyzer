# ── AI provider (all options are free) ───────────────────────────────────────
# No key is required. If nothing below is configured, the app uses its built-in
# rule-based analyzer powered by the live quote and chart data.
#
# Option A: Google Gemini free tier (hosted, no billing required)
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash
#
# Option B: Ollama (100% local, no API key)
# Install from https://ollama.com, then run: ollama pull llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# Optional: allow slower local CPU inference (milliseconds, default 180000)
# OLLAMA_TIMEOUT_MS=180000
#
# Force a provider: gemini | ollama | builtin
# Leave unset to auto-select Gemini, then Ollama, then built-in.
# AI_PROVIDER=gemini

# Optional: Yahoo Finance API (if using a paid service)
# YAHOO_FINANCE_API_KEY=your_key_here

# Optional: Screener.in session cookies (for web scraping)
# SCREENER_SESSION=your_session_cookie_here
